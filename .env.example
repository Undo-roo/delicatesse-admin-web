# ──────────────────────────────────────────────────────────────
# Public runtime config — exposed to the browser.
# Env var name = NUXT_PUBLIC_ + camelCase key from runtimeConfig.public
# ──────────────────────────────────────────────────────────────
ADMIN_API_LINK=http://localhost:8000

# ──────────────────────────────────────────────────────────────
# Private runtime config — server-only, never sent to the client.
# ──────────────────────────────────────────────────────────────
NUXT_API_SECRET=

VERSION="1.0.0"